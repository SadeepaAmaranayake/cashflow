# Local HTTP port. The server defaults to 4000 when PORT is omitted.
PORT=4000

# Replace every placeholder with values from your MongoDB deployment.
# Never commit the real connection string from server/.env.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/DATABASE_NAME

# Replace this with a random secret containing at least 32 UTF-8 bytes.
# Never reuse this placeholder or commit the real secret from server/.env.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES_LONG
